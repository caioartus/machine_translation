__pycache__/
.DS_Store
.mypy_cache/
outputs/
logs/
# Generated data is rebuilt by the scripts in scripts/ and never committed.
# Exception: data/raw/ holds the original input files (Canvas test sets, pinned
# Tatoeba Challenge downloads), committed so every machine has the same inputs.
data/*
!data/raw/
# Run outputs: the small result files (run_info.json, dev_curve.csv) are committed so the
# whole team can see them; model checkpoints (~2 GB each) and smoke tests are not.
runs*/**/best/
runs_test/
# Default Slurm output files (our jobs write their real logs to logs/slurm/).
slurm-*.out
runs*/**/best/
